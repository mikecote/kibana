{
    "type": "plugin",
    "id": "@kbn/workflows-extensions-example",
    "owner": "@elastic/workflows-eng",
    "description": "Example plugin demonstrating how to register custom workflow extensions",
    "group": "platform",
    "visibility": "private",
    "plugin": {
      "taskTypeContributions": {
        "workflow-steps": ["server/task_types/workflow_steps_contribution.ts"]
      },
      "id": "workflowsExtensionsExample",
      "server": true,
      "browser": true,
      "requiredPlugins": [
        "developerExamples",
        "workflowsExtensions",
        "spaces"
      ]
    }
}


{
  "type": "plugin",
  "id": "@kbn/embeddable-plugin",
  "owner": ["@elastic/kibana-dashboards"],
  "group": "platform",
  "visibility": "shared",
  "description": "Adds embeddables service to Kibana",
  "plugin": {
    "id": "embeddable",
    "browser": true,
    "server": true,
    "requiredPlugins": [
      "data",
      "inspector",
      "uiActions",
      "savedObjectsFinder",
      "savedObjectsManagement",
      "contentManagement"
    ],
    "optionalPlugins": [
      "licensing",
      "savedObjectsTaggingOss",
      "usageCollection",
      "workflowsExtensions"
    ],
    "requiredBundles": ["kibanaReact", "kibanaUtils", "unifiedSearch"],
    "extraPublicDirs": ["common"],
    "taskTypeContributions": {
      "workflow-steps": ["server/task_process/workflow_runtime_contribution.ts"]
    }
  }
}

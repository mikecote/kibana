{
  "type": "plugin",
  "id": "@kbn/dashboard-markdown",
  "owner": "@elastic/kibana-dashboards",
  "description": "Dashboard markdown",
  "group": "platform",
  "visibility": "private",
  "plugin": {
    "taskTypeContributions": { "embeddables": ["server/embeddable_contribution.ts"] },
    "id": "dashboardMarkdown",
    "server": true,
    "browser": true,
    "requiredPlugins": [
      "contentManagement",
      "dataViews",
      "embeddable",
      "expressions",
      "uiActions",
      "dashboard",
      "data",
      "charts",
      "dataViewFieldEditor",
      "visualizations",
      "kibanaUtils"
    ],
    "requiredBundles": ["kibanaReact"],
    "optionalPlugins": ["usageCollection"]
  }
}

{
  "type": "plugin",
  "id": "@kbn/security-solution-plugin",
  "owner": [
    "@elastic/security-solution"
  ],
  "group": "security",
  "visibility": "private",
  "plugin": {
    "id": "securitySolution",
    "browser": true,
    "server": true,
    "taskTypes": [
      "server/task_types/eql.task.ts",
      "server/task_types/esql.task.ts",
      "server/task_types/indicator_match.task.ts",
      "server/task_types/ml.task.ts",
      "server/task_types/new_terms.task.ts",
      "server/task_types/query.task.ts",
      "server/task_types/saved_query.task.ts",
      "server/task_types/threshold.task.ts",
      "server/task_types/notifications.task.ts"
    ],
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"],
      "alerting-rule-read": ["server/task_types/rule_read_contribution.ts"],
      "cases-client": ["server/task_types/cases_client_contribution.ts"],
      "cases-attachment-types": ["server/task_types/case_attachment_type_contribution.ts"],
      "workflow-steps": [
        "server/task_types/workflow_steps_contribution.ts"
      ]
    },
    "configPath": [
      "xpack",
      "securitySolution"
    ],
    "requiredPlugins": [
      "actions",
      "alerting",
      "anonymization",
      "cases",
      "cloud",
      "cloudDefend",
      "cloudSecurityPosture",
      "contentManagement",
      "dashboard",
      "data",
      "dataViews",
      "ecsDataQualityDashboard",
      "elasticAssistant",
      "embeddable",
      "entityStore",
      "eventLog",
      "features",
      "fieldFormats",
      "inference",
      "inspector",
      "kubernetesSecurity",
      "lens",
      "licensing",
      "maps",
      "navigation",
      "ruleRegistry",
      "sessionView",
      "spaces",
      "taskManager",
      "timelines",
      "triggersActionsUi",
      "uiActions",
      "unifiedSearch",
      "kql",
      "files",
      "controls",
      "dataViewEditor",
      "savedObjectsManagement",
      "expressions",
      "stackConnectors",
      "discover",
      "notifications",
      "savedSearch",
      "unifiedDocViewer",
      "charts",
      "inference",
      "discoverShared",
      "productDocBase",
      "telemetry",
      "elasticAssistantSharedState",
      "share",
      "workflowsExtensions"
    ],
    "optionalPlugins": [
      "encryptedSavedObjects",
      "evals",
      "fleet",
      "ml",
      "newsfeed",
      "security",
      "usageCollection",
      "lists",
      "home",
      "management",
      "dataViewFieldEditor",
      "osquery",
      "savedObjectsTaggingOss",
      "automaticImport",
      "serverless",
      "agentBuilder",
      "llmTasks",
      "mitreAttack",
      "cps",
      "searchInferenceEndpoints",
      "esql",
      "alertzero",
      "agenticInvestigations"
    ],
    "requiredBundles": [
      "esUiShared",
      "fleet",
      "kibanaUtils",
      "kibanaReact",
      "usageCollection",
      "lists",
      "ml",
      "mitreAttack",
      "unifiedSearch",
      "esql",
      "agentBuilder",
      "workflowsExtensions"
    ],
    "extraPublicDirs": [
      "common"
    ]
  },
  "build": {
    "extraExcludes": [
      // Data generator episode fixtures are large vendored artifacts intended for dev/testing only.
      // Keep them out of distributable builds.
      "**/scripts/data/episodes/**"
    ]
  }
}
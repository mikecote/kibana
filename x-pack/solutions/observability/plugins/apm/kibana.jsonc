{
  "type": "plugin",
  "id": "@kbn/apm-plugin",
  "owner": ["@elastic/obs-signals-traces-team"],
  "group": "observability",
  "visibility": "private",
  "description": "The user interface for Elastic APM",
  "plugin": {
    "id": "apm",
    "browser": true,
    "server": true,
    "taskTypeContributions": {
      "embeddables": ["server/embeddable_contribution.ts"],
      "alerting-rule-read": ["server/task_types/rule_read_contribution.ts"],
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"],
      "workflow-steps": ["server/task_types/workflow_services_contribution.ts"]
    },
    "taskTypes": [
      "server/task_types/error_count.task.ts",
      "server/task_types/transaction_error_rate.task.ts",
      "server/task_types/transaction_duration.task.ts",
      "server/task_types/anomaly.task.ts"
    ],
    "configPath": ["xpack", "apm"],
    "requiredPlugins": [
      "apmSourcesAccess",
      "apmDataAccess",
      "data",
      "dashboard",
      "contentManagement",
      "controls",
      "embeddable",
      "features",
      "logsShared",
      "inspector",
      "licensing",
      "metricsDataAccess",
      "observability",
      "observabilityShared",
      "exploratoryView",
      "ruleRegistry",
      "triggersActionsUi",
      "share",
      "unifiedSearch",
      "kql",
      "dataViews",
      "lens",
      "maps",
      "uiActions",
      "logsDataAccess",
      "savedSearch",
      "fieldsMetadata",
      "discoverShared",
      "apmShared"
    ],
    "optionalPlugins": [
      "actions",
      "alerting",
      "cases",
      "charts",
      "cloud",
      "discover",
      "fleet",
      "fieldFormats",
      "home",
      "ml",
      "security",
      "slo",
      "spaces",
      "serverless",
      "taskManager",
      "usageCollection",
      "customIntegrations",
      "licenseManagement",
      "profilingDataAccess",
      "observabilityAIAssistant",
      "observabilityAgentBuilder",
      "agentBuilder",
      "workflowsExtensions",
      "slo",
      "cps",
    ],
    "requiredBundles": [
      "fleet",
      "kibanaReact",
      "kibanaUtils",
      "ml",
      "observability",
      "maps",
      "observabilityAgentBuilder",
      "unifiedDocViewer",
      "presentationUtil"
    ]
  }
}

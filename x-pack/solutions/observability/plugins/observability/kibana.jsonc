{
  "type": "plugin",
  "id": "@kbn/observability-plugin",
  "owner": ["@elastic/observability-ui"],
  "group": "observability",
  "visibility": "private",
  "plugin": {
    "id": "observability",
    "browser": true,
    "server": true,
    "taskTypeContributions": {
      "workflow-steps": ["server/task_types/workflow_ui_settings_contribution.ts"],
      "cases-attachment-types": ["server/task_types/case_attachment_type_contribution.ts"]
    },
    "taskTypes": [
      "server/task_types/custom_threshold.task.ts"
    ],
    "configPath": ["xpack", "observability"],
    "requiredPlugins": [
      "alerting",
      "charts",
      "contentManagement",
      "controls",
      "data",
      "dataViews",
      "dataViewEditor",
      "embeddable",
      "fieldFormats",
      "uiActions",
      "features",
      "files",
      "inspector",
      "lens",
      "observabilityShared",
      "ruleRegistry",
      "triggersActionsUi",
      "security",
      "share",
      "unifiedSearch",
      "visualizations",
      "dashboard",
      "expressions",
      "logsDataAccess",
      "licensing",
      "navigation",
      "fieldsMetadata",
      "esql",
      "savedObjectsTagging",
      "streams",
      "kql",
    ],
    "optionalPlugins": [
      "workflowsExtensions",
      "observabilityAgentBuilder",
      "agentBuilder",
      "aiops",
      "cases",
      "discover",
      "exploratoryView",
      "home",
      "globalSearch",
      "usageCollection",
      "cloud",
      "spaces",
      "serverless",
      "observabilityAIAssistant",
      "investigate",
      "cps",
      "ingestHub",
      "significantEvents",
      "nightshiftInvestigations",
    ],
    "requiredBundles": [
      "aiops",
      "cases",
      "data",
      "discover",
      "fleet",
      "logsShared",
      "kibanaReact",
      "kibanaUtils",
      "significantEvents",
      "stackAlerts",
      "observabilityAgentBuilder",
    ],
    "extraPublicDirs": ["common"],
  },
}

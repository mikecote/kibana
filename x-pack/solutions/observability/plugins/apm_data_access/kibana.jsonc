{
  "type": "plugin",
  "id": "@kbn/apm-data-access-plugin",
  "owner": ["@elastic/obs-signals-traces-team"],
  "group": "observability",
  "visibility": "private",
  "plugin": {
    "id": "apmDataAccess",
    "browser": false,
    "server": true,
    "taskTypeContributions": {
      "workflow-steps": ["server/task_types/workflow_services_contribution.ts"]
    },
    "configPath": ["xpack", "apm_data_access"],
    "requiredPlugins": ["data", "apmSourcesAccess"],
    "optionalPlugins": ["security", "workflowsExtensions"],
    "requiredBundles": []
  }
}

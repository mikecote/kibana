{
  "type": "plugin",
  "id": "@kbn/slo-plugin",
  "owner": ["@elastic/nightshift-sre-agent-team"],
  "group": "observability",
  "visibility": "private",
  "plugin": {
    "id": "slo",
    "browser": true,
    "server": true,
    "taskTypes": [
      "server/task_types/slo_burn_rate.task.ts"
    ],
    "taskTypeContributions": {
      "alerting-rule-read": ["server/task_types/rule_read_contribution.ts"],
      "workflow-steps": ["server/task_types/workflow_services_contribution.ts"]
    },
    "configPath": ["xpack", "slo"],
    "requiredPlugins": [
      "aiops",
      "alerting",
      "charts",
      "contentManagement",
      "dashboard",
      "data",
      "dataViewEditor",
      "dataViewFieldEditor",
      "dataViews",
      "discoverShared",
      "embeddable",
      "features",
      "fieldFormats",
      "inspector",
      "lens",
      "licensing",
      "observability",
      "observabilityShared",
      "ruleRegistry",
      "share",
      "sloShared",
      "taskManager",
      "triggersActionsUi",
      "uiActions",
      "unifiedSearch",
      "usageCollection",
      "fieldsMetadata",
      "apmSourcesAccess"
    ],
    "optionalPlugins": [
      "workflowsExtensions",
      "cases",
      "cloud",
      "cps",
      "discover",
      "observabilityAIAssistant",
      "security",
      "serverless",
      "spaces",
      "agentBuilder",
      "observabilityAgentBuilder"
    ],
    "requiredBundles": [
      "embeddable",
      "ingestPipelines",
      "kibanaReact",
      "kibanaUtils",
      "unifiedSearch",
      "observabilityAgentBuilder",
      "presentationUtil"
    ]
  }
}

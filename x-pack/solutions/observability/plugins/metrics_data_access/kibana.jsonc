{
  "type": "plugin",
  "id": "@kbn/metrics-data-access-plugin",
  "owner": ["@elastic/obs-signals-metrics-team"],
  "group": "observability",
  "visibility": "private",
  "description": "Exposes utilities for accessing metrics data",
  "plugin": {
    "id": "metricsDataAccess",
    "browser": true,
    "server": true,
    "taskTypeContributions": {
      "workflow-steps": ["server/task_types/workflow_services_contribution.ts"]
    },
    "configPath": ["xpack", "metrics_data_access"],
    "requiredPlugins": ["data", "observabilityShared"],
    "optionalPlugins": ["workflowsExtensions"],
    "requiredBundles": ["kibanaReact"],
    "extraPublicDirs": ["common"]
  }
}

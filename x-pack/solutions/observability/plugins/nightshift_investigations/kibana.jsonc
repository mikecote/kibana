{
  "type": "plugin",
  "id": "@kbn/nightshift-investigations-plugin",
  "owner": ["@elastic/nightshift"],
  "group": "observability",
  "visibility": "private",
  "description": "Nightshift Investigations — domain API for starting and reading investigations",
  "plugin": {
    "id": "nightshiftInvestigations",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "nightshift_investigations"],
    "requiredPlugins": ["share"],
    "optionalPlugins": [
      "actions",
      "alerting",
      "agentBuilder",
      "agenticInvestigations",
      "contextEngine",
      "encryptedSavedObjects",
      "inference",
      "proposals",
      "ruleRegistry",
      "sandbox",
      "security",
      "spaces",
      "workflowsExtensions",
      "workflowsManagement",
    ],
    "requiredBundles": [],
    "extraPublicDirs": ["common"],
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"],
      "workflow-steps": ["server/task_types/workflow_steps_contribution.ts"],
    },
  },
}

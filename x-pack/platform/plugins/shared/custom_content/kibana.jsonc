{
  "type": "plugin",
  "id": "@kbn/custom-content-plugin",
  "owner": ["@elastic/kibana-dashboards"],
  "group": "platform",
  "visibility": "shared",
  "description": "Custom content embeddable for dashboards",
  "plugin": {
    "id": "customContent",
    "browser": true,
    "server": true,
    "taskTypeContributions": {
      "embeddables": ["server/embeddable_contribution.ts"],
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"]
    },
    "requiredPlugins": [
      "embeddable",
      "data",
      "esql",
      "uiActions"
    ],
    "optionalPlugins": [
      "agentBuilder"
    ]
  }
}

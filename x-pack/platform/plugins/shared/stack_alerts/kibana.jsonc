{
  "type": "plugin",
  "id": "@kbn/stack-alerts-plugin",
  "owner": [
    "@elastic/response-ops"
  ],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "taskTypeContributions": {"alerting-rule-read": ["server/task_types/rule_read_contribution.ts"]},
    "id": "stackAlerts",
    "browser": true,
    "server": true,
    "taskTypes": [
      "server/task_types/es_query.task.ts",
      "server/task_types/index_threshold.task.ts",
      "server/task_types/geo_containment.task.ts"
    ],
    "configPath": [
      "xpack",
      "stack_alerts"
    ],
    "requiredPlugins": [
      "unifiedSearch",
      "kql",
      "alerting",
      "features",
      "triggersActionsUi",
      "kibanaReact",
      "data",
      "dataViews",
      "kibanaUtils"
    ],
    "requiredBundles": [
      "esUiShared",
      "esql"
    ],
    "extraPublicDirs": [
      "common"
    ]
  }
}
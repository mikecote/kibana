{
  "type": "plugin",
  "id": "@kbn/proposals-plugin",
  "owner": ["@elastic/security-solution"],
  "group": "platform",
  "visibility": "shared",
  "description": "Solution-agnostic proposals: a recommendation an agent makes and a human decides, gated by a managed workflow. Owns the record, its API, and its workflow steps.",
  "plugin": {
    "id": "proposals",
    "configPath": ["xpack", "proposals"],
    "taskTypeContributions": {
      "workflow-steps": ["server/task_types/workflow_steps_contribution.ts"],
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"]
    },
    "browser": true,
    "server": true,
    "requiredPlugins": ["agentBuilder", "features", "workflowsExtensions", "workflowsManagement"],
    "requiredBundles": ["kibanaReact"],
    "optionalPlugins": ["security", "spaces"]
  }
}

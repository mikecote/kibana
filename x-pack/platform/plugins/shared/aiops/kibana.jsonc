{
  "type": "plugin",
  "id": "@kbn/aiops-plugin",
  "owner": [
    "@elastic/search-ml-ux"
  ],
  "group": "platform",
  "visibility": "shared",
  "description": "AIOps plugin maintained by ML team.",
  "plugin": {
    "id": "aiops",
    "browser": true,
    "server": true,
    "taskTypeContributions": {
      "embeddables": ["server/embeddable_contribution.ts"],
      "cases-attachment-types": ["server/task_types/case_attachment_type_contribution.ts"]
    },
    "configPath": ["xpack", "aiops"],
    "requiredPlugins": [
      "charts",
      "data",
      "lens",
      "licensing",
      "uiActions",
      "embeddable",
      "dashboard",
      "fieldFormats",
      "unifiedSearch",
      "share"
    ],
    "optionalPlugins": [
      "cases",
      "observabilityAIAssistant",
      "usageCollection",
      "cps",
      "dataViewEditor",
      "dataViewFieldEditor",
      "contentManagement"
    ],
    "requiredBundles": [
      "fieldFormats",
      "kibanaReact",
      "kibanaUtils",
      "cases",
      "savedSearch",
      "savedObjectsFinder",
      "presentationUtil"
    ]
  }
}

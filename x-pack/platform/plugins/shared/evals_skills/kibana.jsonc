{
  "type": "plugin",
  "id": "@kbn/evals-skills-plugin",
  "owner": ["@elastic/nightshift-context-and-research-team"],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "evalsSkills",
    "server": true,
    "browser": false,
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"]
    },
    "requiredPlugins": ["agentBuilder", "workflowsManagement", "evals"],
    "optionalPlugins": ["spaces", "security"]
  }
}

{
  "type": "plugin",
  "id": "@kbn/context-engine-agent-builder-plugin",
  "owner": "@elastic/context-eng",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "contextEngineAgentBuilder",
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"]
    },
    "browser": true,
    "server": true,
    "requiredPlugins": ["agentBuilder", "contextEngine", "workflowsManagement", "security"],
    "optionalPlugins": ["spaces", "searchInferenceEndpoints"]
  }
}

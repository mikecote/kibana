{
  "type": "plugin",
  "id": "@kbn/streams-plugin",
  "owner": "@elastic/streams-ui",
  "description": "A manager for Streams",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "streams",
    "configPath": [
      "xpack",
      "streams"
    ],
    "browser": true,
    "server": true,
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"],
      "workflow-steps": ["server/task_types/fields_metadata_runtime_contribution.ts"]
    },
    "requiredPlugins": [
      "actions",
      "alerting",
      "console",
      "data",
      "encryptedSavedObjects",
      "features",
      "inference",
      "licensing",
      "ruleRegistry",
      "security",
      "usageCollection",
      "fieldsMetadata"
    ],
    "optionalPlugins": [
      "agentBuilder",
      "agentBuilderSml",
      "cloud",
      "esql",
      "serverless",
      "globalSearch",
      "searchInferenceEndpoints",
      "spaces",
      "workflowsExtensions",
      "workflowsManagement"
    ],
    "requiredBundles": [],
    "extraPublicDirs": [
      "common"
    ]
  }
}

{
  "type": "plugin",
  "id": "@kbn/agent-builder-dashboards-plugin",
  "owner": "@elastic/kibana-dashboards",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "agentBuilderDashboards",
    "server": true,
    "browser": true,
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"]
    },
    "configPath": ["xpack", "agentBuilderDashboards"],
    "requiredPlugins": [
      "agentBuilder",
      "dashboard",
      "dashboardMarkdown",
      "embeddable",
      "data",
      "agentBuilderSml",
      "share",
      "uiActions",
      "unifiedSearch"
    ]
  }
}

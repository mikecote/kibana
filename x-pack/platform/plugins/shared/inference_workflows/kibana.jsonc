{
  "type": "plugin",
  "id": "@kbn/inference-workflows-plugin",
  "owner": ["@elastic/search-ml-ux"],
  "group": "platform",
  "visibility": "shared",
  "description": "Registers AI workflow steps (ai.prompt, ai.summarize, ai.classify) that bridge the inference and workflows_extensions plugins.",
  "plugin": {
    "id": "inferenceWorkflows",
    "server": true,
    "browser": true,
    "configPath": ["xpack", "inferenceWorkflows"],
    "taskTypeContributions": {
      "workflow-steps": ["server/task_types/workflow_steps_contribution.ts"]
    },
    "requiredPlugins": ["inference", "workflowsExtensions", "searchInferenceEndpoints"]
  }
}

{
  "type": "plugin",
  "id": "@kbn/apm-sources-access-plugin",
  "owner": ["@elastic/obs-signals-traces-team"],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "apmSourcesAccess",
    "server": true,
    "taskTypeContributions": {
      "workflow-steps": ["server/task_types/workflow_services_contribution.ts"]
    },
    "browser": true,
    "configPath": [
      "xpack",
      "apm_sources_access"
    ],
    "requiredPlugins": [
      "data",
      "dataViews",
    ],
    "optionalPlugins": ["workflowsExtensions"],
    "requiredBundles": []
  }
}

{
  "type": "plugin",
  "id": "@kbn/agent-builder-visualizations-plugin",
  "owner": "@elastic/kibana-dashboards",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "agentBuilderVisualizations",
    "server": true,
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"]
    },
    "browser": true,
    "configPath": ["xpack", "agentBuilderVisualizations"],
    "requiredPlugins": [
      "agentBuilder",
      "agentBuilderSml",
      "lens",
      "data",
      "dataViews",
      "uiActions",
      "unifiedSearch",
      "embeddable"
    ],
    "requiredBundles": [
      "presentationUtil"
    ]
  }
}

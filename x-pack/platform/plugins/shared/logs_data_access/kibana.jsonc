{
  "type": "plugin",
  "id": "@kbn/logs-data-access-plugin",
  "owner": [
    "@elastic/obs-signals-logs-team"
  ],
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "logsDataAccess",
    "server": true,
    "taskTypeContributions": {
      "workflow-steps": ["server/task_types/workflow_services_contribution.ts"]
    },
    "browser": true,
    "requiredPlugins": [
      "data",
      "dataViews"
    ],
    "optionalPlugins": ["workflowsExtensions"],
    "requiredBundles": []
  }
}

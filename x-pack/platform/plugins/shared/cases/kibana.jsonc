{
  "type": "plugin",
  "id": "@kbn/cases-plugin",
  "owner": ["@elastic/security-investigations"],
  "group": "platform",
  "visibility": "shared",
  "description": "The Case management system in Kibana",
  "plugin": {
    "id": "cases",
    "browser": true,
    "server": true,
    "configPath": ["xpack", "cases"],
    "requiredPlugins": [
      "alerting",
      "actions",
      "data",
      "embeddable",
      "lens",
      "licensing",
      "features",
      "triggersActionsUi",
      "fieldFormats",
      "management",
      "security",
      "notifications",
      "ruleRegistry",
      "files",
      "contentManagement",
      "uiActions",
      "workflowsExtensions"
    ],
    "optionalPlugins": [
      "agentBuilder",
      "cloud",
      "dataViews",
      "dashboard",
      "home",
      "maps",
      "taskManager",
      "usageCollection",
      "spaces",
      "serverless",
      "savedObjectsTaggingOss",
      "workflowsManagement"
    ],
    "requiredBundles": [
      "dashboard",
      "esUiShared",
      "kibanaReact",
      "kibanaUtils",
      "savedObjectsFinder"
    ],
    "extraPublicDirs": ["common"],
    "taskTypeContributions": {
      "agent-builder": [
        "server/task_types/agent_builder_contribution.ts"
      ],
      "alerting-rule-run": [
        "server/task_types/rule_run_contribution.ts"
      ],
      "workflow-steps": [
        "server/task_types/workflow_steps_contribution.ts"
      ]
    }
  }
}

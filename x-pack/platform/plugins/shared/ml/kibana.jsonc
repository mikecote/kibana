{
  "type": "plugin",
  "id": "@kbn/ml-plugin",
  "owner": ["@elastic/search-ml-ux"],
  "group": "platform",
  "visibility": "shared",
  "description": "This plugin provides access to the machine learning features provided by Elastic.",
  "plugin": {
    "id": "ml",
    "browser": true,
    "server": true,
    "taskTypes": [
      "server/task_types/anomaly_detection_alert.task.ts",
      "server/task_types/anomaly_detection_jobs_health.task.ts"
    ],
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"],
      "workflow-steps": ["server/task_types/workflow_services_contribution.ts"]
    },
    "configPath": ["xpack", "ml"],
    "requiredPlugins": [
      "aiops",
      "charts",
      "cloud",
      "data",
      "dataViewEditor",
      "dataViewFieldEditor",
      "dataViews",
      "dataVisualizer",
      "discover",
      "embeddable",
      "features",
      "fieldFormats",
      "lens",
      "licensing",
      "share",
      "taskManager",
      "triggersActionsUi",
      "uiActions",
      "unifiedSearch",
      "kql",
      "savedObjectsManagement",
      "savedSearch",
      "contentManagement",
      "fieldsMetadata",
      "fileUpload"
    ],
    "optionalPlugins": [
      "alerting",
      "dashboard",
      "home",
      "licenseManagement",
      "management",
      "maps",
      "security",
      "spaces",
      "observabilityAIAssistant",
      "usageCollection",
      "cases",
      "cps",
      "agentBuilder",
      "workflowsExtensions"
    ],
    "requiredBundles": [
      "cases",
      "charts",
      "dashboard",
      "esUiShared",
      "fieldFormats",
      "kibanaReact",
      "kibanaUtils",
      "lens",
      "maps",
      "savedObjectsFinder",
      "usageCollection",
      "alerting",
      "presentationUtil"
    ],
    "extraPublicDirs": ["common"]
  }
}

{
  "type": "plugin",
  "id": "@kbn/agentic-investigations-plugin",
  "owner": ["@elastic/security-solution", "@elastic/nightshift"],
  "group": "platform",
  "visibility": "shared",
  "description": "Solution-agnostic base layer for agentic investigations. Owns the entities an agent and a human collaborate on (impact and escalations today, investigations next) and the investigation and escalation conversation template UI. Proposals live in the `proposals` plugin.",
  "plugin": {
    "id": "agenticInvestigations",
    "configPath": ["xpack", "agenticInvestigations"],
    "browser": true,
    "server": true,
    "taskTypeContributions": {
      "agent-builder": ["server/task_types/agent_builder_contribution.ts"],
      "workflow-steps": ["server/task_types/workflow_steps_contribution.ts"]
    },
    "requiredPlugins": ["agentBuilder", "agentBuilderPlatform", "features", "workflowsExtensions"],
    "requiredBundles": ["kibanaReact", "proposals"],
    "optionalPlugins": ["security", "spaces", "proposals", "workflowsManagement", "entityStore"],
    "extraPublicDirs": ["common"]
  }
}
